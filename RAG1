function resetSimulator() {

    document.getElementById("query").value = "";

    document.getElementById("queryDisplay")
        .textContent = "—";

    document.getElementById("queryVector")
        .innerHTML = "";

    document.getElementById("searchResults")
        .innerHTML = "";

    document.getElementById("rerankResults")
        .innerHTML = "";

    document.getElementById("context")
        .innerHTML = "";

    document.getElementById("prompt")
        .textContent =
        "Run the simulator to see the prompt.";

    document.getElementById("answer")
        .textContent =
        "Run the simulator to generate an answer.";

    document.getElementById("sources")
        .innerHTML = "";

    renderChunks();

    document.querySelectorAll(".pipeline-step")
        .forEach(element =>
            element.classList.remove("active")
        );

    document.querySelectorAll(".chunk")
        .forEach(element =>
            element.classList.remove("selected")
        );
}


