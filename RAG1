<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RAG Simulator</title>

<style>
    * {
        box-sizing: border-box;
    }

    :root {
        --bg: #f5f5f7;
        --card: #ffffff;
        --text: #1d1d1f;
        --muted: #6e6e73;
        --border: #e5e5e7;
        --blue: #0071e3;
        --blue-light: #eaf4ff;
        --green: #16803c;
        --green-light: #eaf8ef;
        --orange: #b45309;
        --orange-light: #fff7e8;
        --purple: #6941c6;
        --purple-light: #f4efff;
        --shadow: 0 10px 30px rgba(0,0,0,0.06);
    }

    body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
                     Roboto, Helvetica, Arial, sans-serif;
        line-height: 1.5;
    }

    .container {
        width: min(1200px, 92%);
        margin: 0 auto;
    }

    /* HERO */

    header {
        background: #111111;
        color: white;
        padding: 70px 0 60px;
    }

    .eyebrow {
        color: #8abfff;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    h1 {
        font-size: clamp(38px, 6vw, 68px);
        line-height: 1.05;
        letter-spacing: -3px;
        margin: 0 0 18px;
    }

    .hero-text {
        max-width: 760px;
        color: #b8b8bd;
        font-size: 19px;
    }

    /* PIPELINE */

    .pipeline {
        display: flex;
        align-items: center;
        gap: 8px;
        overflow-x: auto;
        padding: 24px 0;
        scrollbar-width: thin;
    }

    .pipeline-step {
        flex: 0 0 auto;
        background: white;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 10px 14px;
        font-size: 13px;
        font-weight: 600;
        color: var(--muted);
        transition: 0.25s;
    }

    .pipeline-step.active {
        background: var(--blue);
        color: white;
        border-color: var(--blue);
        transform: translateY(-2px);
    }

    .arrow {
        color: #aaa;
        flex: 0 0 auto;
    }

    /* CONTROLS */

    .controls {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 25px;
    }

    button {
        border: 0;
        border-radius: 12px;
        padding: 12px 20px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

    .primary {
        background: var(--blue);
        color: white;
    }

    .primary:hover {
        background: #0064c9;
        transform: translateY(-1px);
    }

    .secondary {
        background: white;
        color: var(--text);
        border: 1px solid var(--border);
    }

    .secondary:hover {
        background: #fafafa;
    }

    /* QUERY */

    .query-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 25px;
        box-shadow: var(--shadow);
        margin-bottom: 25px;
    }

    label {
        display: block;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 8px;
        color: var(--muted);
    }

    textarea {
        width: 100%;
        min-height: 85px;
        resize: vertical;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 14px;
        font: inherit;
        outline: none;
        background: #fafafa;
    }

    textarea:focus {
        border-color: var(--blue);
        background: white;
        box-shadow: 0 0 0 3px rgba(0,113,227,0.1);
    }

    .examples {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 12px;
    }

    .example {
        background: #f2f2f4;
        color: #444;
        padding: 8px 11px;
        border-radius: 20px;
        font-size: 12px;
        cursor: pointer;
    }

    .example:hover {
        background: #e6e6e8;
    }

    /* GRID */

    .grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 20px;
    }

    @media (max-width: 850px) {
        .grid {
            grid-template-columns: 1fr;
        }
    }

    .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 24px;
        box-shadow: var(--shadow);
    }

    .card.full {
        grid-column: 1 / -1;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 18px;
    }

    .card-title {
        font-size: 19px;
        font-weight: 700;
        letter-spacing: -0.4px;
    }

    .badge {
        font-size: 11px;
        font-weight: 700;
        padding: 5px 9px;
        border-radius: 20px;
        background: var(--blue-light);
        color: var(--blue);
        white-space: nowrap;
    }

    .badge.green {
        background: var(--green-light);
        color: var(--green);
    }

    .badge.orange {
        background: var(--orange-light);
        color: var(--orange);
    }

    .badge.purple {
        background: var(--purple-light);
        color: var(--purple);
    }

    .description {
        color: var(--muted);
        font-size: 13px;
        margin-bottom: 18px;
    }

    /* DOCUMENT */

    .document {
        background: #fafafa;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 18px;
        font-size: 13px;
        max-height: 260px;
        overflow-y: auto;
    }

    .document-title {
        font-weight: 700;
        margin-bottom: 12px;
    }

    .document p {
        margin: 8px 0;
        color: #555;
    }

    /* CHUNKS */

    .chunk {
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 14px;
        margin-bottom: 10px;
        background: white;
        transition: 0.25s;
    }

    .chunk.selected {
        border-color: var(--blue);
        background: var(--blue-light);
    }

    .chunk-top {
        display: flex;
        justify-content: space-between;
        margin-bottom: 6px;
    }

    .chunk-id {
        font-size: 11px;
        font-weight: 700;
        color: var(--blue);
    }

    .score {
        font-size: 11px;
        font-weight: 700;
    }

    .chunk-text {
        font-size: 13px;
        color: #555;
    }

    /* VECTOR */

    .vector {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .number {
        background: #f2f2f4;
        border-radius: 7px;
        padding: 7px 9px;
        font-family: monospace;
        font-size: 12px;
    }

    .vector-label {
        font-size: 12px;
        color: var(--muted);
        margin: 10px 0 7px;
    }

    /* SEARCH */

    .search-result {
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 10px;
    }

    .search-result.top {
        border-color: #a9d2ff;
        background: var(--blue-light);
    }

    .result-row {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 6px;
    }

    .bar {
        height: 7px;
        background: #e8e8ea;
        border-radius: 20px;
        overflow: hidden;
        margin-top: 10px;
    }

    .bar-fill {
        height: 100%;
        background: var(--blue);
        border-radius: inherit;
        width: 0;
        transition: width 0.8s ease;
    }

    /* PROMPT */

    .prompt {
        background: #111;
        color: #e8e8e8;
        border-radius: 14px;
        padding: 18px;
        font-family: monospace;
        font-size: 12px;
        white-space: pre-wrap;
        overflow-x: auto;
        max-height: 340px;
        overflow-y: auto;
    }

    /* ANSWER */

    .answer {
        background: var(--green-light);
        border: 1px solid #b9e3c6;
        border-radius: 15px;
        padding: 20px;
    }

    .answer-title {
        color: var(--green);
        font-weight: 800;
        margin-bottom: 10px;
    }

    .answer-text {
        font-size: 16px;
        line-height: 1.7;
    }

    .source {
        display: inline-block;
        background: white;
        border: 1px solid #cde6d4;
        border-radius: 7px;
        padding: 3px 7px;
        margin: 3px;
        font-size: 11px;
        font-weight: 700;
        color: var(--green);
    }

    /* INFO */

    .info-box {
        padding: 16px;
        border-radius: 12px;
        background: #f7f7f8;
        border: 1px solid var(--border);
        font-size: 13px;
        color: #555;
        margin-top: 15px;
    }

    .info-box strong {
        color: var(--text);
    }

    .truth {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    @media (max-width: 750px) {
        .truth {
            grid-template-columns: 1fr;
        }
    }

    .truth-card {
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 15px;
        background: #fafafa;
    }

    .truth-card h4 {
        margin: 0 0 7px;
        font-size: 14px;
    }

    .truth-card p {
        margin: 0;
        color: var(--muted);
        font-size: 12px;
    }

    footer {
        text-align: center;
        color: var(--muted);
        font-size: 12px;
        padding: 40px 0;
    }

    .hidden {
        display: none;
    }
</style>
</head>

<body>

<header>
    <div class="container">
        <div class="eyebrow">Interactive Learning Tool</div>

        <h1>RAG Simulator</h1>

        <div class="hero-text">
            Understand how Retrieval-Augmented Generation works,
            step by step — from a document all the way to a grounded
            LLM answer.
        </div>
    </div>
</header>


<main class="container">

    <!-- PIPELINE -->

    <div class="pipeline" id="pipeline">

        <div class="pipeline-step" data-step="1">1. Documents</div>
        <div class="arrow">→</div>

        <div class="pipeline-step" data-step="2">2. Chunking</div>
        <div class="arrow">→</div>

        <div class="pipeline-step" data-step="3">3. Embeddings</div>
        <div class="arrow">→</div>

        <div class="pipeline-step" data-step="4">4. Vector DB</div>
        <div class="arrow">→</div>

        <div class="pipeline-step" data-step="5">5. Query</div>
        <div class="arrow">→</div>

        <div class="pipeline-step" data-step="6">6. Query Embedding</div>
        <div class="arrow">→</div>

        <div class="pipeline-step" data-step="7">7. Retrieval</div>
        <div class="arrow">→</div>

        <div class="pipeline-step" data-step="8">8. Top-K</div>
        <div class="arrow">→</div>

        <div class="pipeline-step" data-step="9">9. Re-ranking</div>
        <div class="arrow">→</div>

        <div class="pipeline-step" data-step="10">10. Context</div>
        <div class="arrow">→</div>

        <div class="pipeline-step" data-step="11">11. LLM</div>
        <div class="arrow">→</div>

        <div class="pipeline-step" data-step="12">12. Answer</div>

    </div>


    <!-- QUERY -->

    <section class="query-card">

        <label for="query">
            ASK A QUESTION
        </label>

        <textarea
            id="query"
            placeholder="Example: How long are customer documents retained?"
        ></textarea>

        <div class="examples">

            <div class="example"
                 onclick="setQuery('How long are customer documents retained?')">
                Document retention
            </div>

            <div class="example"
                 onclick="setQuery('How can I search customer documents?')">
                Document search
            </div>

            <div class="example"
                 onclick="setQuery('Who can access customer documents?')">
                Access control
            </div>

            <div class="example"
                 onclick="setQuery('What happens when a customer account is migrated?')">
                Account migration
            </div>

        </div>

        <div class="controls" style="margin-top:18px;">
            <button class="primary" onclick="runRAG()">
                ▶ Run RAG
            </button>

            <button class="secondary" onclick="resetSimulator()">
                Reset
            </button>
        </div>

    </section>


    <!-- DOCUMENT + CHUNKS -->

    <div class="grid">

        <section class="card">

            <div class="card-header">
                <div class="card-title">1. Source Document</div>
                <div class="badge">RAW TEXT</div>
            </div>

            <div class="description">
                This represents a document stored in your company's
                knowledge repository.
            </div>

            <div class="document">

                <div class="document-title">
                    Customer & Document Management Guide
                </div>

                <p>
                    Customer documents are stored in the enterprise
                    content management platform.
                </p>

                <p>
                    Customer records are retained for seven years after
                    the relevant account relationship ends, unless a
                    longer regulatory period applies.
                </p>

                <p>
                    Users can search documents using customer ID,
                    account number, document type and other metadata.
                </p>

                <p>
                    Access to customer documents is controlled using
                    role-based access controls.
                </p>

                <p>
                    During customer migration, the old customer ID is
                    mapped to the new customer ID.
                </p>

                <p>
                    Documents associated with the old customer record
                    are migrated to the new content management location.
                </p>

                <p>
                    Document migration is validated after transfer to
                    ensure documents remain accessible and correctly
                    associated with the customer.
                </p>

                <p>
                    Search results can be filtered using metadata such
                    as customer ID, document type and date.
                </p>

            </div>

            <div class="info-box">
                <strong>Important:</strong>
                The LLM does not automatically know this private
                company document. RAG retrieves relevant information
                and places it into the LLM's context.
            </div>

        </section>


        <section class="card">

            <div class="card-header">
                <div class="card-title">2. Chunking</div>
                <div class="badge orange">TEXT → CHUNKS</div>
            </div>

            <div class="description">
                The document is divided into smaller pieces so that
                retrieval can find the relevant section instead of
                passing the entire document to the LLM.
            </div>

            <div id="chunks"></div>

        </section>

    </div>


    <!-- EMBEDDING + VECTOR DB -->

    <div class="grid">

        <section class="card">

            <div class="card-header">
                <div class="card-title">3. Embedding</div>
                <div class="badge purple">VECTOR</div>
            </div>

            <div class="description">
                Each chunk is converted into a numerical representation
                called an embedding.
            </div>

            <div class="vector-label">
                Example embedding for Chunk C2
            </div>

            <div class="vector" id="chunkVector"></div>

            <div class="info-box">
                <strong>Key distinction:</strong>
                the chunk itself remains text. The embedding is a
                numerical representation of that text used for
                similarity comparison.
            </div>

            <div class="info-box">
                <strong>This simulator:</strong>
                uses a small deterministic toy embedding so you can
                see the mechanics. Real applications use an embedding
                model such as an API or local embedding model.
            </div>

        </section>


        <section class="card">

            <div class="card-header">
                <div class="card-title">4. Vector Database</div>
                <div class="badge green">INDEX</div>
            </div>

            <div class="description">
                Embeddings are stored alongside their original text
                and metadata in a vector database.
            </div>

            <div id="vectorDB"></div>

            <div class="info-box">
                <strong>Think of it as:</strong>
                Text + Embedding + Metadata.
                The vector database makes similarity retrieval
                efficient.
            </div>

        </section>

    </div>


    <!-- QUERY EMBEDDING -->

    <div class="grid">

        <section class="card">

            <div class="card-header">
                <div class="card-title">5–6. Query & Query Embedding</div>
                <div class="badge purple">SEARCH VECTOR</div>
            </div>

            <div class="description">
                Your question is also converted into an embedding.
                The query vector is then compared with document vectors.
            </div>

            <div class="info-box">
                <strong>Your query:</strong>
                <span id="queryDisplay">—</span>
            </div>

            <div class="vector-label">
                Query embedding
            </div>

            <div class="vector" id="queryVector"></div>

        </section>


        <!-- RETRIEVAL -->

        <section class="card">

            <div class="card-header">
                <div class="card-title">7–8. Similarity Search & Top-K</div>
                <div class="badge">RETRIEVAL</div>
            </div>

            <div class="description">
                The vector database compares the query vector against
                document vectors. Higher similarity means greater
                relevance.
            </div>

            <div id="searchResults"></div>

        </section>

    </div>


    <!-- RERANK + CONTEXT -->

    <div class="grid">

        <section class="card">

            <div class="card-header">
                <div class="card-title">9. Re-ranking</div>
                <div class="badge orange">OPTIONAL</div>
            </div>

            <div class="description">
                Production RAG systems may use a second model
                called a reranker to improve the ordering of
                retrieved chunks.
            </div>

            <div id="rerankResults"></div>

            <div class="info-box">
                <strong>Important:</strong>
                Re-ranking is not mandatory for every RAG system.
                It is an additional retrieval-quality technique.
            </div>

        </section>


        <section class="card">

            <div class="card-header">
                <div class="card-title">10. Context Assembly</div>
                <div class="badge green">TOP 3</div>
            </div>

            <div class="description">
                The selected chunks are assembled into context that
                will be provided to the LLM.
            </div>

            <div id="context"></div>

        </section>

    </div>


    <!-- LLM -->

    <section class="card full" style="margin-bottom:20px;">

        <div class="card-header">
            <div class="card-title">11. Prompt Sent to the LLM</div>
            <div class="badge purple">GENERATION</div>
        </div>

        <div class="description">
            The LLM receives the user's question plus the retrieved
            context. The LLM generates the final natural-language
            answer.
        </div>

        <div class="prompt" id="prompt">
            Run the simulator to see the prompt.
        </div>

    </section>


    <!-- ANSWER -->

    <section class="card full" style="margin-bottom:20px;">

        <div class="card-header">
            <div class="card-title">12. Grounded Answer</div>
            <div class="badge green">LLM OUTPUT</div>
        </div>

        <div class="answer">

            <div class="answer-title">
                ✓ Answer generated using retrieved context
            </div>

            <div class="answer-text" id="answer">
                Run the simulator to generate an answer.
            </div>

            <div style="margin-top:15px;" id="sources"></div>

        </div>

    </section>


    <!-- KEY CONCEPTS -->

    <section class="card full">

        <div class="card-header">
            <div class="card-title">
                The 5 Things You Should Remember
            </div>
        </div>

        <div class="truth">

            <div class="truth-card">
                <h4>① Chunks remain text</h4>
                <p>
                    The original document is split into smaller
                    text passages. The text does not become a vector.
                </p>
            </div>

            <div class="truth-card">
                <h4>② Embeddings are vectors</h4>
                <p>
                    An embedding model converts text into numbers
                    representing semantic meaning.
                </p>
            </div>

            <div class="truth-card">
                <h4>③ Vector DB performs retrieval</h4>
                <p>
                    The retriever searches the vector index.
                    The LLM itself is not searching the database.
                </p>
            </div>

            <div class="truth-card">
                <h4>④ Top-K becomes context</h4>
                <p>
                    Only the most relevant retrieved chunks are
                    normally passed into the LLM prompt.
                </p>
            </div>

            <div class="truth-card">
                <h4>⑤ RAG ≠ training</h4>
                <p>
                    Adding documents to a RAG system does not
                    retrain the LLM. The documents are retrieved
                    at query time.
                </p>
            </div>

            <div class="truth-card">
                <h4>⑥ Cost can be reduced</h4>
                <p>
                    RAG can reduce context/token usage compared with
                    sending a large document corpus to the LLM.
                </p>
            </div>

        </div>

    </section>

</main>


<footer>
    RAG Simulator · Educational demonstration · No external APIs
</footer>


<script>

/* =========================================================
   DATA
   ========================================================= */

const chunks = [
    {
        id: "C1",
        title: "Document Storage",
        text: "Customer documents are stored in the enterprise content management platform."
    },
    {
        id: "C2",
        title: "Retention",
        text: "Customer records are retained for seven years after the relevant account relationship ends, unless a longer regulatory period applies."
    },
    {
        id: "C3",
        title: "Document Search",
        text: "Users can search documents using customer ID, account number, document type and other metadata."
    },
    {
        id: "C4",
        title: "Access Control",
        text: "Access to customer documents is controlled using role-based access controls."
    },
    {
        id: "C5",
        title: "Customer Migration",
        text: "During customer migration, the old customer ID is mapped to the new customer ID."
    },
    {
        id: "C6",
        title: "Document Migration",
        text: "Documents associated with the old customer record are migrated to the new content management location."
    },
    {
        id: "C7",
        title: "Migration Validation",
        text: "Document migration is validated after transfer to ensure documents remain accessible and correctly associated with the customer."
    },
    {
        id: "C8",
        title: "Search Filtering",
        text: "Search results can be filtered using metadata such as customer ID, document type and date."
    }
];


/*
    These keywords form a very small educational "embedding space".

    Real embedding models do NOT work like this.

    This simplified approach allows the browser to demonstrate:
       text → vector
       query → vector
       cosine similarity
*/

const dimensions = [
    ["retention", ["retain", "retention", "seven", "years", "regulatory"]],
    ["search", ["search", "filter", "metadata", "document"]],
    ["access", ["access", "role", "permission", "control"]],
    ["migration", ["migration", "migrated", "transfer", "mapping", "mapped"]],
    ["customer", ["customer", "account", "id"]],
    ["document", ["document", "documents", "content"]],
    ["validation", ["validate", "validated", "validation", "correctly"]],
    ["storage", ["stored", "storage", "location", "platform"]]
];


/* =========================================================
   EMBEDDING
   ========================================================= */

function createEmbedding(text) {

    const lower = text.toLowerCase();

    const vector = dimensions.map(([name, keywords]) => {

        let score = 0;

        keywords.forEach(keyword => {

            if (lower.includes(keyword)) {
                score += 1;
            }

        });

        return score;
    });

    /*
        Normalize vector.
        This is similar in spirit to what we need
        when calculating cosine similarity.
    */

    const magnitude = Math.sqrt(
        vector.reduce((sum, value) => sum + value * value, 0)
    );

    if (magnitude === 0) {
        return vector.map(() => 0);
    }

    return vector.map(value => value / magnitude);
}


/* =========================================================
   COSINE SIMILARITY
   ========================================================= */

function cosineSimilarity(a, b) {

    let dot = 0;

    let magnitudeA = 0;
    let magnitudeB = 0;

    for (let i = 0; i < a.length; i++) {

        dot += a[i] * b[i];

        magnitudeA += a[i] * a[i];

        magnitudeB += b[i] * b[i];
    }

    if (magnitudeA === 0 || magnitudeB === 0) {
        return 0;
    }

    return dot / (
        Math.sqrt(magnitudeA) *
        Math.sqrt(magnitudeB)
    );
}


/* =========================================================
   DISPLAY HELPERS
   ========================================================= */

function vectorHTML(vector) {

    return vector.map(value => {

        return `
            <div class="number">
                ${value.toFixed(2)}
            </div>
        `;

    }).join("");
}


function setQuery(text) {

    document.getElementById("query").value = text;

    runRAG();
}


function escapeHTML(text) {

    return text
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}


/* =========================================================
   INITIAL CHUNK DISPLAY
   ========================================================= */

function renderChunks() {

    const container = document.getElementById("chunks");

    container.innerHTML = chunks.map(chunk => {

        return `
            <div class="chunk" id="chunk-${chunk.id}">

                <div class="chunk-top">

                    <div class="chunk-id">
                        ${chunk.id} · ${chunk.title}
                    </div>

                </div>

                <div class="chunk-text">
                    ${chunk.text}
                </div>

            </div>
        `;

    }).join("");
}


/* =========================================================
   VECTOR DATABASE DISPLAY
   ========================================================= */

function renderVectorDB() {

    const container = document.getElementById("vectorDB");

    container.innerHTML = chunks.map(chunk => {

        const vector = createEmbedding(chunk.text);

        return `
            <div class="chunk">

                <div class="chunk-top">

                    <div class="chunk-id">
