                        `<div class="number">${v.toFixed(2)}</div>`
                    ).join("")}
                </div>

            </div>
        `;

    }).join("");
}


/* =========================================================
   PIPELINE ANIMATION
   ========================================================= */

function activatePipeline(step) {

    document.querySelectorAll(".pipeline-step")
        .forEach(element => {

            element.classList.remove("active");

            if (
                parseInt(element.dataset.step) === step
            ) {
                element.classList.add("active");
            }

        });
}


/* =========================================================
   MAIN RAG FLOW
   ========================================================= */

function runRAG() {

    const queryInput =
        document.getElementById("query").value.trim();

    if (!queryInput) {

        alert("Please enter a question first.");

        return;
    }


    /* STEP 1 */

    activatePipeline(1);


    /* STEP 2 */

    setTimeout(() => {

        activatePipeline(2);

        renderChunks();

    }, 250);


    /* STEP 3 */

    setTimeout(() => {

        activatePipeline(3);

        const vector =
            createEmbedding(chunks[1].text);

        document.getElementById("chunkVector").innerHTML =
            vectorHTML(vector);

    }, 500);


    /* STEP 4 */

    setTimeout(() => {

        activatePipeline(4);

        renderVectorDB();

    }, 750);


    /* STEP 5 */

    setTimeout(() => {

        activatePipeline(5);

        document.getElementById("queryDisplay")
            .textContent = queryInput;

    }, 1000);


    /* STEP 6 */

    const queryVector =
        createEmbedding(queryInput);

    setTimeout(() => {

        activatePipeline(6);

        document.getElementById("queryVector").innerHTML =
            vectorHTML(queryVector);

    }, 1250);


    /* STEP 7 */

    const results = chunks.map(chunk => {

        const vector =
            createEmbedding(chunk.text);

        const similarity =
            cosineSimilarity(queryVector, vector);

        return {
            ...chunk,
            vector,
            similarity
        };

    }).sort((a, b) =>
        b.similarity - a.similarity
    );


    /* STEP 8 */

    setTimeout(() => {

        activatePipeline(7);

        renderSearchResults(results);

    }, 1500);


    setTimeout(() => {

        activatePipeline(8);

        renderSearchResults(results);

    }, 1800);


    /* STEP 9 */

    setTimeout(() => {

        activatePipeline(9);

        const topFive = results.slice(0, 5);

        const reranked =
            rerank(topFive, queryInput);

        renderReranked(reranked);

    }, 2150);


    /* STEP 10 */

    setTimeout(() => {

        activatePipeline(10);

        const topFive = results.slice(0, 5);

        const reranked =
            rerank(topFive, queryInput);

        const context =
            reranked.slice(0, 3);

        renderContext(context);

    }, 2500);


    /* STEP 11 */

    setTimeout(() => {

        activatePipeline(11);

        const topFive = results.slice(0, 5);

        const reranked =
            rerank(topFive, queryInput);

        const context =
            reranked.slice(0, 3);

        renderPrompt(queryInput, context);

    }, 2850);


    /* STEP 12 */

    setTimeout(() => {

        activatePipeline(12);

        const topFive = results.slice(0, 5);

        const reranked =
            rerank(topFive, queryInput);

        const context =
            reranked.slice(0, 3);

        generateAnswer(queryInput, context);

    }, 3200);
}


/* =========================================================
   SEARCH RESULTS
   ========================================================= */

function renderSearchResults(results) {

    const container =
        document.getElementById("searchResults");

    container.innerHTML = results.map((result, index) => {

        const percentage =
            Math.max(0, Math.min(100, result.similarity * 100));

        return `
            <div class="search-result ${index < 3 ? "top" : ""}">

                <div class="result-row">

                    <strong>
                        ${result.id} · ${result.title}
                    </strong>

                    <span class="score">
                        ${(result.similarity * 100).toFixed(1)}%
                    </span>

                </div>

                <div style="font-size:12px;color:#666;">
                    ${result.text}
                </div>

                <div class="bar">

                    <div
                        class="bar-fill"
                        style="width:${percentage}%">
                    </div>

                </div>

            </div>
        `;

    }).join("");
}


/* =========================================================
   TOY RERANKER
   ========================================================= */

function rerank(results, query) {

    const words =
        query.toLowerCase()
             .split(/\s+/)
             .filter(word => word.length > 3);

    return results.map(result => {

        let bonus = 0;

        words.forEach(word => {

            if (
                result.text.toLowerCase().includes(word)
            ) {
                bonus += 0.08;
            }

            if (
                result.title.toLowerCase().includes(word)
            ) {
                bonus += 0.12;
            }

        });

        return {
            ...result,
            rerankScore:
                Math.min(1, result.similarity + bonus)
        };

    }).sort((a, b) =>
        b.rerankScore - a.rerankScore
    );
}


function renderReranked(results) {

    const container =
        document.getElementById("rerankResults");

    container.innerHTML = results.map((result, index) => {

        return `
            <div class="search-result ${index < 3 ? "top" : ""}">

                <div class="result-row">

                    <strong>
                        #${index + 1} · ${result.id}
                    </strong>

                    <span class="score">
                        ${(result.rerankScore * 100).toFixed(1)}%
                    </span>

                </div>

                <div style="font-size:12px;color:#666;">
                    ${result.title}
                </div>

            </div>
        `;

    }).join("");
}


/* =========================================================
   CONTEXT
   ========================================================= */

function renderContext(context) {

    const container =
        document.getElementById("context");

    container.innerHTML = context.map((chunk, index) => {

        document
            .getElementById(`chunk-${chunk.id}`)
            ?.classList.add("selected");

        return `
            <div class="chunk selected">

                <div class="chunk-top">

                    <div class="chunk-id">
                        Context ${index + 1} · ${chunk.id}
                    </div>

                </div>

                <div class="chunk-text">
                    ${chunk.text}
                </div>

            </div>
        `;

    }).join("");
}


/* =========================================================
   PROMPT
   ========================================================= */

function renderPrompt(query, context) {

    const contextText =
        context.map(chunk => {

            return `[${chunk.id}] ${chunk.text}`;

        }).join("\n\n");

    const prompt = `
SYSTEM:
You are a helpful assistant.
Answer using the provided context.
If the answer is not contained in the context,
say that the information is not available.

CONTEXT:
${contextText}

USER QUESTION:
${query}

INSTRUCTION:
Provide a concise answer grounded in the context.
Cite the relevant source chunks.
`;

    document.getElementById("prompt").textContent =
        prompt;
}


/* =========================================================
   SIMULATED LLM ANSWER
   ========================================================= */

function generateAnswer(query, context) {

    const lower =
        query.toLowerCase();

    let answer = "";
    let sourceIds = [];


    if (
        lower.includes("retain") ||
        lower.includes("retention") ||
        lower.includes("how long")
    ) {

        answer =
            "Customer records are retained for seven years after the relevant account relationship ends, unless a longer regulatory retention period applies.";

        sourceIds = ["C2"];

    } else if (
        lower.includes("search")
    ) {

        answer =
            "Users can search customer documents using information such as customer ID, account number, document type and other metadata. Search results can also be filtered using metadata such as customer ID, document type and date.";

        sourceIds = ["C3", "C8"];

    } else if (
        lower.includes("access") ||
        lower.includes("permission") ||
        lower.includes("who can")
    ) {

        answer =
            "Access to customer documents is controlled using role-based access controls.";

        sourceIds = ["C4"];

    } else if (
        lower.includes("migration") ||
        lower.includes("migrate") ||
        lower.includes("account")
    ) {

        answer =
            "During customer migration, the old customer ID is mapped to the new customer ID. Documents associated with the old customer record are then migrated to the new content management location and the migration is validated.";

        sourceIds = ["C5", "C6", "C7"];

    } else {

        /*
            Generic fallback based on retrieved context.
        */

        answer =
            "The retrieved documents indicate that this information is managed within the enterprise content management process. The most relevant retrieved context should be used to answer the question.";

        sourceIds =
            context.slice(0, 2).map(item => item.id);
    }


    document.getElementById("answer").textContent =
        answer;


    document.getElementById("sources").innerHTML =
        sourceIds.map(id => {

            return `
                <span class="source">
                    Source: ${id}
                </span>
            `;

        }).join("");
}


